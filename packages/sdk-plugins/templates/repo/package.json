{
  "name": "PLUGIN_NAME",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "main": "dist/react/main.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/react/main.js",
      "default": "./dist/react/main.js"
    },
    "./angular": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/cross-framework/main.js",
      "default": "./dist/cross-framework/main.js"
    },
    "./vue": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/cross-framework/main.js",
      "default": "./dist/cross-framework/main.js"
    }
  },
  "typesVersions": {
    "*": {
      "angular": [
        "./dist/types/index.d.ts"
      ],
      "vue": [
        "./dist/types/index.d.ts"
      ]
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:prod": "vite build",
    "build:fusion": "vite build -- --fusion",
    "deploy": "vite build -- --fusion && node ./node_modules/@sisense/sdk-plugins-dev/dist/scripts/deploy.js",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --quiet --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@sisense/sdk-ui": "CSDK_VERSION",
    "@sisense/sdk-ui-preact": "CSDK_VERSION",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@sisense/sdk-ui": {
      "optional": true
    },
    "@sisense/sdk-ui-preact": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.0",
    "@sisense/sdk-data": "CSDK_VERSION",
    "@sisense/sdk-plugins-dev": "CSDK_VERSION",
    "@sisense/sdk-ui": "CSDK_VERSION",
    "@types/node": "^22.5.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "preact": "^10.26.8",
    "prettier": "^3.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "~4.9.3",
    "sass": "^1.77.0",
    "vite": "^7",
    "@vitejs/plugin-react": "^4.0.0",
    "vitest": "^3.2.4",
    "jsdom": "^25.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.6.0"
  }
}
