{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run build:fusion)",
      "Bash(npm run test)",
      "Bash(npm run test:watch)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx @sisense/sdk-cli get-api-token*)",
      "Bash(npx @sisense/sdk-cli get-data-model*)",
      "Bash(ls *)",
      "Bash(find . *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(npm --version)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsc --noEmit --pretty false 2>&1 | grep 'error TS' | head -10 || true"
          }
        ]
      }
    ]
  }
}
