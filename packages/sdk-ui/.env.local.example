# Copy this file to .env.local and fill in your values.
# .env.local is gitignored. All variables are injected at server start time
# via the `sisense-runtime-config` Vite plugin — no rebuild needed when
# switching values. See src/__demo__/demo-app-config.ts for field descriptions.

# --- Sisense instance connection (required) ---
VITE_APP_SISENSE_URL=https://<hostname>

# Authentication — choose one:
VITE_APP_SISENSE_TOKEN=<api-token>
# VITE_APP_SISENSE_WAT=<web-access-token>
# VITE_APP_SISENSE_SSO_ENABLED=true

# --- Dev / test behaviour (optional, default: false) ---
# VITE_APP_DISABLE_STRICT_MODE=true
# VITE_APP_DISABLE_ERROR_OVERLAY=true
# VITE_APP_DISABLE_ANIMATION=true

# --- Content (optional) ---
# Sisense theme OIDs for light / dark mode (uses default SDK theme when absent)
# VITE_APP_SISENSE_THEME_OID_LIGHT=<oid>
# VITE_APP_SISENSE_THEME_OID_DARK=<oid>

# Pipe-separated list of dashboard:widget OID pairs, e.g.:
# VITE_APP_WIDGETS=dashId1:widgetId1,widgetId2|dashId2:widgetId3
