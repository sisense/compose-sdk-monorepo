{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ES2019", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsxImportSource": "vue",
    // @vue/tsconfig 0.5 enables verbatimModuleSyntax by default; keep it off to preserve the
    // previous module-emit behavior (this upgrade only moves TypeScript to 5.5.4 and vue-tsc to 2.x).
    "verbatimModuleSyntax": false
  },
  "references": [{ "path": "../sdk-ui-preact" }, { "path": "./tsconfig.node.json" }]
}
